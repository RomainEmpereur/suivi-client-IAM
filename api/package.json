{
  "name": "@obsidian/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "cd .. && npm run build:worker && cd api && wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply espace-obsidian --local",
    "db:seed:local": "wrangler d1 execute espace-obsidian --local --file ../db/seed/.demo.sql"
  },
  "dependencies": {
    "@obsidian/domain": "*",
    "hono": "^4.13.18",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "wrangler": "^4.160.1"
  }
}
